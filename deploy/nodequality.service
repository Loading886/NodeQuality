[Unit]
Description=NodeQuality SSH IP query service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/nodequality/nodequality serve --listen :2222 --host-key /var/lib/nodequality/ssh_host_ed25519_key
DynamicUser=yes
StateDirectory=nodequality
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
